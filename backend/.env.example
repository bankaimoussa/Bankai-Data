# انسخ هذا الملف باسم .env محليًا، أو ضع نفس المتغيرات في إعدادات Render/Vercel

# كلمة مرور الدخول للموقع
ADMIN_PASSWORD=bankai

# مفتاح سري عشوائي لتوقيع جلسات الدخول (اي نص طويل عشوائي)
JWT_SECRET=غيّر_ده_لنص_عشوائي_طويل_جدا

# ID بتاع ملف الجوجل شيت (موجود في رابط الشيت بين d/ و /edit)
SPREADSHEET_ID=ضع_ال_ID_هنا

# اسماء الفروع (شيتات) مفصولة بفاصلة - لازم تطابق اسماء التابات بالظبط
BRANCHES=QCD1,QCD2

# محتوى ملف الـ Service Account JSON بالكامل في سطر واحد (اقرأ التعليمات)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", "...":"..."}

PORT=3000
